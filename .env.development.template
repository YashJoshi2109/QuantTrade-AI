# ============================================
# QuantTrade AI - Local Development Environment
# ============================================
# Copy this file to .env.development and fill in your values
#
# Usage:
#   cp .env.development.template .env.development
#   # Edit .env.development with your values
#   docker compose -f docker-compose.dev.yml up --build
# ============================================

# ===================
# Database (Required)
# ===================
# Neon PostgreSQL connection string
DATABASE_URL=postgresql://user:password@host/database?sslmode=require

# ===================
# JWT Authentication
# ===================
SECRET_KEY=your-dev-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ===================
# App URLs (Local Dev)
# ===================
APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000

# Stripe Payment Links + optional Buy Button (frontend — use Test mode keys/links in dev)
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_MONTHLY=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_PAYMENT_LINK_YEARLY=https://buy.stripe.com/...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
# NEXT_PUBLIC_STRIPE_BUY_BUTTON_MONTHLY_ID=buy_btn_...
# NEXT_PUBLIC_STRIPE_BUY_BUTTON_YEARLY_ID=buy_btn_...

# ===================
# Frontend Analytics (Optional)
# ===================
# Google Tag Manager container ID (e.g. GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ===================
# Stripe (Test Mode — use Test Dashboard price IDs, not Live)
# ===================
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Recurring subscription prices only. One-time prices fail for mode=subscription.
# Create: Product → Add price → Recurring (monthly / yearly). Copy both price_... IDs.
STRIPE_PRICE_PLUS_MONTHLY=price_xxx
STRIPE_PRICE_PLUS_YEARLY=price_xxx

# ===================
# API Keys
# ===================
OPENAI_API_KEY=sk-xxx
ANTHROPIC_API_KEY=sk-ant-xxx
NEWSAPI_KEY=xxx
ALPHA_VANTAGE_API_KEY=xxx
FINNHUB_API_KEY=xxx

# ===================
# Google OAuth (Optional)
# ===================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Frontend: NEXT_PUBLIC_GOOGLE_CLIENT_ID must match GOOGLE_CLIENT_ID

# ===================
# Email OTP — put Brevo keys in backend/.env (see backend/.env.example)
# ===================
# BREVO_API_KEY=
# BREVO_FROM_EMAIL=QuantTrade AI <verified-sender@example.com>
# If verifier fails locally: DEBUG=true. If Brevo fails: EMAIL_DEV_LOG_OTP=true in backend/.env

# ===================
# Neon Auth (Optional)
# ===================
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_AUDIENCE=

# ===================
# Debug Settings
# ===================
DEBUG=true
LOG_LEVEL=DEBUG
# Backend only (put in backend/.env): EMAIL_DEV_LOG_OTP=true prints OTP to terminal when mail fails
