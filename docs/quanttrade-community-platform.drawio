                    <mxGeometry x="-50" y="2" width="40" height="38" as="geometry"/>
                </mxCell>
                <mxCell id="step-3-desc-lg" value="&lt;div&gt;&lt;b&gt;Compute Services&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Next.js Frontend serves SSR pages; FastAPI Core API handles auth, market data, and copilot; Community Service manages posts, comments, and feeds&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-3-lg" vertex="1">
                    <mxGeometry x="52" width="548" height="110" as="geometry"/>
