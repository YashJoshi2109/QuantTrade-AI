                <mxCell id="step-5-desc-lg" value="&lt;div&gt;&lt;b&gt;AI Moderation Pipeline&lt;/b&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;color: light-dark(rgb(0,0,0), rgb(255,255,255));&quot;&gt;&lt;b&gt;&lt;font style=&quot;font-size: 15px;&quot;&gt;-&lt;/font&gt; &lt;/b&gt;Lambda consumes SQS events and validates financial content via Amazon Bedrock for claim detection, manipulation patterns, and SEC compliance&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;spacingTop=-4;fontSize=14;labelBackgroundColor=none;whiteSpace=wrap;fontFamily=Helvetica;" parent="step-5-lg" vertex="1">
