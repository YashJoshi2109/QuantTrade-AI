# Global Monitor API Keys - REFERENCE ONLY
# Add these variables to your main backend/.env file. The app reads only from .env.

# ===================================
# OpenSky Network (Flight Tracking)
# ===================================
# Sign up at: https://opensky-network.org/
# Free tier: 400 credits/day (1 credit per request)
OPENSKY_USERNAME=your_opensky_username_here
OPENSKY_PASSWORD=your_opensky_password_here

# ===================================
# GDELT (Global News Events) – used for globe events
# ===================================
# Free API, no key required. Backend: GDELTFetcher, sync_gdelt_news.
# https://api.gdeltproject.org/api/v2/doc/doc
GDELT_API_KEY=  # Optional, leave empty for public access

# ===================================
# ACLED (Armed Conflict Location & Event Data)
# ===================================
# New Auth: OAuth 2.0 (Email + Password) - No static API key required
ACLED_EMAIL=your_email@gmail.com
ACLED_PASSWORD=your_acled_password_here
# Legacy Key (Optional, if you still have one)
ACLED_API_KEY=

# ===================================
# USGS (Earthquake Data) – used for disaster events on globe
# ===================================
# Free public API, no key required. Backend: USGSFetcher, sync_usgs_earthquakes.
# https://earthquake.usgs.gov/fdsnws/event/1/
USGS_API_KEY=  # No key required

# ===================================
# NASA FIRMS (Fire/Thermal Anomalies)
# ===================================
# Sign up at: https://firms.modaps.eosdis.nasa.gov/api/
# Free tier: Unlimited
NASA_FIRMS_API_KEY=your_nasa_firms_key_here

# ===================================
# NASA EONET (Natural Events)
# ===================================
# Free public API, no key required
# Documentation: https://eonet.gsfc.nasa.gov/docs/v3
NASA_EONET_API_KEY=  # No key required

# ===================================
# Cloudflare Radar (Cyber Threats)
# ===================================
# Get API token at: https://dash.cloudflare.com/profile/api-tokens
# Requires Cloudflare account
CLOUDFLARE_RADAR_TOKEN=your_cloudflare_radar_token_here

# ===================================
# FRED (Economic Data)
# ===================================
# Sign up at: https://fred.stlouisfed.org/docs/api/api_key.html
# Free tier: Unlimited
FRED_API_KEY=your_fred_api_key_here

# ===================================
# Polymarket (Prediction Markets) – used for right-panel heatmap & predictions
# ===================================
# Public API, no key required. Frontend: gamma-api.polymarket.com
# https://gamma-api.polymarket.com/events
POLYMARKET_API_KEY=  # Optional

# ===================================
# VesselFinder (Maritime Traffic)
# ===================================
# Sign up at: https://www.vesselfinder.com/api
# Free tier: 300 requests/day
VESSELFINDER_API_KEY=your_vesselfinder_key_here

# ===================================
# AISStream (Global Shipping AIS Websocket)
# ===================================
# Sign up at: https://aisstream.io/
# Used for high-frequency live vessel positions (shipping category)
AISSTREAM_API_KEY=your_aisstream_api_key_here

# ===================================
# Groq (LLM for Threat Classification)
# ===================================
# Sign up at: https://console.groq.com/
# Free tier: 14,400 requests/day (Llama 3.1 70B)
GROQ_API_KEY=your_groq_api_key_here

# ===================================
# Upstash Redis (Caching & Deduplication)
# ===================================
# Sign up at: https://upstash.com/
# Free tier: 10,000 commands/day
UPSTASH_REDIS_URL=your_redis_url_here
UPSTASH_REDIS_TOKEN=your_redis_token_here

# ===================================
# Redis Configuration
# ===================================
REDIS_URL=${UPSTASH_REDIS_URL}
REDIS_MAX_CONNECTIONS=10
REDIS_DEDUP_TTL=86400  # 24 hours
CIRCUIT_BREAKER_THRESHOLD=5
CIRCUIT_BREAKER_TIMEOUT=300  # 5 minutes

# ===================================
# Global Monitor Settings
# ===================================
GLOBAL_MONITOR_ENABLED=true
GLOBAL_MONITOR_SYNC_INTERVAL=900  # 15 minutes
GLOBAL_MONITOR_MAX_EVENTS_PER_SYNC=500
GLOBAL_MONITOR_RETENTION_DAYS=30

# ===================================
# Celery Configuration
# ===================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=["json"]
CELERY_TIMEZONE=UTC

# ===================================
# Existing Database Configuration
# ===================================
# (Keep your existing DATABASE_URL)

# ===================================
# Quick Start Guide
# ===================================
# 
# CRITICAL APIs (required for core functionality):
# 1. GROQ_API_KEY - AI threat classification
# 2. UPSTASH_REDIS_URL - Caching and deduplication
# 
# HIGH PRIORITY APIs (highly recommended):
# 3. ACLED_API_KEY - Conflict/protest data
# 4. NASA_FIRMS_API_KEY - Fire and disaster tracking
# 5. FRED_API_KEY - Economic indicators
# 
# OPTIONAL APIs (enhance coverage):
# 6. OPENSKY_API_KEY - Flight tracking in conflict zones
# 7. CLOUDFLARE_RADAR_API_KEY - Cyber threat intelligence
# 8. VESSELFINDER_API_KEY - Maritime shipping disruptions
# 
# FREE APIs (no key needed):
# - GDELT (news events)
# - USGS (earthquakes)
# - NASA EONET (natural disasters)
# - Polymarket (prediction markets)
#
