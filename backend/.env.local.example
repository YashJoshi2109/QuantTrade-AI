# Local development environment — copy to backend/.env.local (git-ignored).
#
# Used two ways:
#   1. docker compose -f docker-compose.dev.yml up      (compose overrides the DB/Redis lines)
#   2. uvicorn on the host:  cd backend && set -a && . ./.env.local && set +a && uvicorn app.main:app --reload
#
# NEVER put the production DATABASE_URL here. With APP_ENV=development the backend
# refuses to start against a non-local database host.

APP_ENV=development

# Local Postgres/Redis from docker-compose.dev.yml (host ports 5433 / 6380)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/quanttrade
REDIS_URL=redis://localhost:6380/0

# Background jobs (scheduler, forecast warm) only run in production
RUN_BACKGROUND_JOBS=0
FORECAST_WARM=0

# Small pool: a dev box needs a handful of connections, not 40
DB_POOL_SIZE=2
DB_MAX_OVERFLOW=3

ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Optional API keys (features degrade gracefully without them) ──
# FINNHUB_API_KEY=
# FMP_API_KEY=
# FRED_API_KEY=
# ANTHROPIC_API_KEY=
# JWT_SECRET_KEY=local-dev-only-change-me
