{
  "_comment": "RECORDED / SYNTHETIC tool outputs for the offline institutional eval. Each entry stands in for the production engine tool of the SAME NAME (fundamentals, valuation, quant, filings engines) so the orchestration (planner -> parallel tool calls -> composer -> grounding guard) can be tested with no network and no LLM. The numbers are fixtures, not real company data; never show them to users. Each tool: spec (copied from the production registry; test_recorded_specs_match_registry keeps them in sync), optional per-ticker responses ('*' = any ticker), per_ticker (one fact per ticker for multi-ticker tools).",
  "tools": {
    "get_financial_history": {
      "spec": {
        "name": "get_financial_history",
        "description": "Normalised 1-10y annual or quarterly income statement, balance sheet, cash flow from SEC XBRL, with filing accession per period and restatement notes.",
        "input_schema": {
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string"
            },
            "period": {
              "type": "string",
              "enum": [
                "annual",
                "quarterly"
              ]
            },
            "years": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10
            },
            "statement": {
              "type": "string",
              "enum": [
                "all",
                "income",
                "balance",
                "cashflow"
              ]
            }
          },
          "required": [
            "ticker"
          ],
          "additionalProperties": false
        }
      },
      "progress": "Fetching {years}y statements for {ticker}",
      "responses": {
        "*": {
          "title": "{ticker} annual statements (SEC XBRL)",
          "source": "SEC XBRL companyfacts (recorded fixture)",
          "as_of": "2026-02-26",
          "filing_type": "10-K",
          "filed_date": "2026-02-26",
          "accession": "0001045810-26-000012",
          "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&type=10-K",
          "values": {
            "revenue_latest": 130497000000,
            "net_income_latest": 72880000000,
            "operating_cash_flow_latest": 64089000000,
            "capex_latest": 3236000000,
            "free_cash_flow_latest": 60853000000,
            "revenue_cagr_5y": 0.6412
          },
          "formulas": {
            "free_cash_flow": "operating cash flow - capital expenditures",
            "revenue_cagr_5y": "(revenue_t / revenue_t-5)^(1/5) - 1"
          }
        }
      }
    },
    "analyze_earnings_quality": {
      "spec": {
        "name": "analyze_earnings_quality",
        "description": "Forensic accounting (SEC XBRL): net income vs OCF, balance-sheet and cash-flow accrual ratios, DSO/DIO/DPO/CCC, Beneish M, SBC, earnings-quality flags.",
        "input_schema": {
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string"
            },
            "years": {
              "type": "integer",
              "minimum": 2,
              "maximum": 10
            }
          },
          "required": [
            "ticker"
          ],
          "additionalProperties": false
        }
      },
      "responses": {
        "*": {
          "title": "{ticker} earnings quality",
          "source": "Computed from SEC XBRL statements (recorded fixture)",
          "as_of": "2026-02-26",
          "values": {
            "sloan_accrual_ratio": 0.0812,
            "cash_conversion": 0.8794,
            "net_income_growth": 1.4498,
            "ocf_growth": 1.1817,
            "dso_days": 53.2,
            "dio_days": 81.4,
            "dpo_days": 41.7,
            "cash_conversion_cycle_days": 92.9
          },
          "formulas": {
            "sloan_accrual_ratio": "(net income - operating cash flow) / average total assets",
            "cash_conversion": "operating cash flow / net income",
            "cash_conversion_cycle_days": "DSO + DIO - DPO"
