      "spec": {
        "name": "valuation_scenarios",
        "description": "Scenario engine on the latest FY: FX via disclosed geographic revenue mix, tariffs/cost via COGS, demand, revenue, margin, opex, capex and rate shocks -> individual and combined EPS and DCF value impacts. `shocks` = individual+combined; `scenarios` = named cases.",
        "input_schema": {
          "type": "object",
          "properties": {
            "ticker": {
              "type": "string",
              "description": "Ticker symbol, e.g. MSFT"
            },
            "shocks": {
              "type": "object",
              "description": "Shocks as fractions: reporting_currency_appreciation, demand_decline, revenue_change, tariff_rate, cogs_inflation, gross_margin_change, opex_change, capex_change, rate_shock (e.g. reporting_currency_appreciation 0.10 = USD +10%, rate_shock 0.01 = +100bp)."
            },
            "scenarios": {
              "type": "array",
              "maxItems": 5,
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "rationale": {
                    "type": "string"
                  },
                  "shocks": {
                    "type": "object",
                    "description": "Shocks as fractions: reporting_currency_appreciation, demand_decline, revenue_change, tariff_rate, cogs_inflation, gross_margin_change, opex_change, capex_change, rate_shock (e.g. reporting_currency_appreciation 0.10 = USD +10%, rate_shock 0.01 = +100bp)."
                  }
                },
                "required": [
                  "name",
                  "shocks"
                ]
              }
            },
            "structure": {
              "type": "object",
              "description": "Structural inputs (fractions): foreign_revenue_share (default: XBRL geographic disclosure), tariff_exposed_cogs_share (required with tariff_rate), tariff_pass_through(0), foreign_cost_share(0), hedge_ratio(0), variable_cogs_share(1), floating_rate_debt_share(0), capex_shock_years(3)."
            },
            "assumptions": {
              "type": "object",
              "description": "Same optional overrides as valuation_dcf.assumptions."
            }
          },
          "required": [
            "ticker"
          ],
          "additionalProperties": false
        }
      }
    },
