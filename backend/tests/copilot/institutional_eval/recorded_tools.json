                          "assumptions": {"bear_demand_shock": -0.2, "bear_margin_compression_pp": -4.0, "bull_revenue_growth": 0.25, "base_revenue_growth": 0.12}}}
    },
    "quant_volatility_regime": {
      "spec": {"name": "quant_volatility_regime",
