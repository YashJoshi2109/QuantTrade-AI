{
  "_comment": "RECORDED / SYNTHETIC tool outputs for the offline institutional eval. They stand in for the fundamentals_*, valuation_*, quant_* and filings_* engines so the orchestration (planner -> parallel tool calls -> composer -> grounding guard) can be tested with no network and no LLM. The numbers are fixtures, not real company data; never show them to users. Each tool: spec (registered exactly like a production tool), optional per-ticker responses ('*' = any ticker), per_ticker (one fact per ticker for multi-ticker tools).",
  "tools": {
    "fundamentals_statements": {
      "spec": {"name": "fundamentals_statements",
               "description": "Multi-year annual financial statements from SEC XBRL companyfacts (income statement, balance sheet, cash flow) with filing accession and fiscal period for every value.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "years": {"type": "integer", "minimum": 1, "maximum": 10}}, "required": ["ticker"], "additionalProperties": false}},
      "progress": "Fetching {years}y statements for {ticker}",
      "responses": {"*": {"title": "{ticker} annual statements (SEC XBRL)", "source": "SEC XBRL companyfacts (recorded fixture)", "as_of": "2026-02-26",
                          "filing_type": "10-K", "filed_date": "2026-02-26", "accession": "0001045810-26-000012", "url": "https://www.sec.gov/cgi-bin/browse-edgar?action=getcompany&type=10-K",
                          "values": {"revenue_latest": 130497000000, "net_income_latest": 72880000000, "operating_cash_flow_latest": 64089000000, "capex_latest": 3236000000, "free_cash_flow_latest": 60853000000, "revenue_cagr_5y": 0.6412},
                          "formulas": {"free_cash_flow": "operating cash flow - capital expenditures", "revenue_cagr_5y": "(revenue_t / revenue_t-5)^(1/5) - 1"}}}
    },
    "fundamentals_earnings_quality": {
      "spec": {"name": "fundamentals_earnings_quality",
               "description": "Forensic earnings-quality metrics from SEC statements: Sloan accrual ratio, cash conversion (OCF / net income), working capital days (DSO, DIO, DPO, cash conversion cycle) per fiscal year.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "years": {"type": "integer"}}, "required": ["ticker"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} earnings quality", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2026-02-26",
                          "values": {"sloan_accrual_ratio": 0.0812, "cash_conversion": 0.8794, "net_income_growth": 1.4498, "ocf_growth": 1.1817, "dso_days": 53.2, "dio_days": 81.4, "dpo_days": 41.7, "cash_conversion_cycle_days": 92.9},
                          "formulas": {"sloan_accrual_ratio": "(net income - operating cash flow) / average total assets", "cash_conversion": "operating cash flow / net income", "cash_conversion_cycle_days": "DSO + DIO - DPO"}}}
    },
    "fundamentals_roic": {
      "spec": {"name": "fundamentals_roic",
               "description": "Return on invested capital (NOPAT / invested capital) per fiscal year with value-driver attribution: margin, capital turnover, leverage and buyback contribution to per-share growth.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "years": {"type": "integer"}}, "required": ["ticker"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} ROIC", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2025-10-31",
                          "values": {"roic_latest": 0.5612, "roic_5y_avg": 0.4975, "nopat_margin": 0.2611, "invested_capital_turnover": 2.149, "buyback_eps_contribution": 0.0314},
                          "formulas": {"roic": "NOPAT / (total debt + equity - cash)", "nopat": "operating income x (1 - effective tax rate)"},
                          "assumptions": {"tax_rate_source": "effective tax rate from 10-K"}}}
    },
    "fundamentals_dupont": {
      "spec": {"name": "fundamentals_dupont",
               "description": "DuPont decomposition of return on equity (ROE = net margin x asset turnover x equity multiplier) from SEC statements.",
               "input_schema": {"type": "object", "properties": {"tickers": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 6}}, "required": ["tickers"], "additionalProperties": false}},
      "per_ticker": true,
      "responses": {"*": {"title": "{ticker} DuPont ROE", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2026-02-26",
                          "values": {"roe": 1.3652, "net_margin": 0.2397, "asset_turnover": 1.1561, "equity_multiplier": 4.9265},
                          "formulas": {"roe": "net margin x asset turnover x equity multiplier"}}}
    },
    "fundamentals_distress": {
      "spec": {"name": "fundamentals_distress",
               "description": "Financial distress models: Altman Z-score, Piotroski F-score, Beneish M-score, interest coverage, current and quick ratios, debt maturity schedule from 10-K notes.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}}, "required": ["ticker"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} distress scores", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2026-01-30",
                          "filing_type": "10-K", "filed_date": "2026-01-30", "accession": "0000050863-26-000009", "section": "Item 8 - Note: Borrowings",
                          "values": {"altman_z": 1.62, "piotroski_f": 3, "beneish_m": -2.41, "interest_coverage": 1.9, "current_ratio": 1.33, "quick_ratio": 0.98, "debt_due_within_2y": 6450000000},
                          "formulas": {"altman_z": "1.2 X1 + 1.4 X2 + 3.3 X3 + 0.6 X4 + 1.0 X5", "beneish_m": "-4.84 + 0.92 DSRI + 0.528 GMI + 0.404 AQI + 0.892 SGI + 0.115 DEPI - 0.172 SGAI + 4.679 TATA - 0.327 LVGI", "interest_coverage": "EBIT / interest expense"}}}
    },
    "fundamentals_peer_metrics": {
      "spec": {"name": "fundamentals_peer_metrics",
               "description": "Peer comparison: gross margin, revenue growth, ROIC, capital intensity (capex / revenue), free cash flow conversion and share dilution for several companies from SEC statements.",
               "input_schema": {"type": "object", "properties": {"tickers": {"type": "array", "items": {"type": "string"}, "minItems": 2, "maxItems": 8}}, "required": ["tickers"], "additionalProperties": false}},
      "per_ticker": true,
      "responses": {"*": {"title": "{ticker} peer metrics", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2026-02-26",
                          "values": {"gross_margin": 0.7498, "revenue_growth": 0.5221, "roic": 0.4411, "capex_to_revenue": 0.0655, "fcf_conversion": 0.9123, "share_dilution": 0.0091}}}
    },
    "fundamentals_capex_intensity": {
      "spec": {"name": "fundamentals_capex_intensity",
               "description": "Capital expenditure, depreciation burden (D&A / revenue), capital intensity and incremental ROIC on recent capex, with cloud segment revenue growth where disclosed.",
               "input_schema": {"type": "object", "properties": {"tickers": {"type": "array", "items": {"type": "string"}, "minItems": 1, "maxItems": 6}}, "required": ["tickers"], "additionalProperties": false}},
      "per_ticker": true,
      "responses": {"*": {"title": "{ticker} capex intensity", "source": "Computed from SEC XBRL statements (recorded fixture)", "as_of": "2026-01-29",
                          "values": {"capex_latest": 64551000000, "capex_to_revenue": 0.2286, "depreciation_to_revenue": 0.0911, "incremental_roic": 0.1874, "cloud_revenue_growth": 0.2104},
                          "formulas": {"incremental_roic": "change in NOPAT / change in invested capital (3y)"}}}
    },
    "valuation_wacc": {
      "spec": {"name": "valuation_wacc",
               "description": "Weighted average cost of capital via CAPM: risk-free rate (FRED DGS10), regression beta, equity risk premium (assumption), after-tax cost of debt, market-value weights.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "equity_risk_premium": {"type": "number"}}, "required": ["ticker"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} WACC", "source": "CAPM over FRED DGS10 + daily bars (recorded fixture)", "as_of": "2026-11-24",
                          "values": {"wacc": 0.0912, "cost_of_equity": 0.0968, "after_tax_cost_of_debt": 0.0341, "risk_free_rate": 0.0428, "beta": 1.08, "equity_weight": 0.9713},
                          "formulas": {"wacc": "E/V x Re + D/V x Rd x (1 - t)", "cost_of_equity": "rf + beta x ERP"},
                          "assumptions": {"equity_risk_premium": 0.05, "tax_rate": 0.18},
                          "inputs": [{"series": "FRED DGS10", "observation_date": "2026-11-24"}]}}
    },
    "valuation_dcf": {
      "spec": {"name": "valuation_dcf",
               "description": "Three-stage discounted cash flow (FCFF) valuation with WACC, terminal growth, intrinsic value per share versus current market capitalization, and a sensitivity matrix over discount rate and revenue growth.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "terminal_growth": {"type": "number"}}, "required": ["ticker"], "additionalProperties": false}},
      "progress": "Running 3-stage DCF for {ticker}",
      "responses": {"*": {"title": "{ticker} 3-stage DCF", "source": "DCF engine over SEC XBRL + quote (recorded fixture)", "as_of": "2026-11-24",
                          "values": {"intrinsic_value_per_share": 431.17, "enterprise_value": 3297000000000, "equity_value": 3205000000000, "market_cap": 3808000000000, "implied_upside": -0.1583},
                          "formulas": {"enterprise_value": "sum FCFF_t / (1 + WACC)^t + TV / (1 + WACC)^N", "terminal_value": "FCFF_N+1 / (WACC - g)"},
                          "assumptions": {"terminal_growth": 0.025, "stage1_revenue_growth": 0.14, "stage2_revenue_growth": 0.08, "wacc": 0.0912},
                          "table": [{"wacc": 0.0812, "growth_low": 452.3, "growth_base": 498.6, "growth_high": 548.9}, {"wacc": 0.0912, "growth_low": 392.1, "growth_base": 431.17, "growth_high": 472.4}, {"wacc": 0.1012, "growth_low": 345.0, "growth_base": 378.2, "growth_high": 413.5}]}}
    },
    "valuation_reverse_dcf": {
      "spec": {"name": "valuation_reverse_dcf",
               "description": "Reverse DCF: solves for the revenue growth, operating margin and reinvestment rate implied by the current market valuation over a projection horizon.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "horizon_years": {"type": "integer"}}, "required": ["ticker"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} reverse DCF", "source": "Reverse DCF engine (recorded fixture)", "as_of": "2026-11-24",
                          "values": {"implied_revenue_cagr": 0.2215, "implied_terminal_operating_margin": 0.1964, "implied_reinvestment_rate": 0.3412, "market_cap": 1104000000000},
                          "assumptions": {"wacc": 0.1045, "terminal_growth": 0.03, "horizon_years": 10}}}
    },
    "valuation_monte_carlo": {
      "spec": {"name": "valuation_monte_carlo",
               "description": "Monte Carlo DCF valuation simulation with probabilistic revenue growth, operating margin, discount rate and terminal growth; reports median, 5th and 95th percentile value per share and probability below the current price.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "n_simulations": {"type": "integer", "minimum": 1000, "maximum": 100000}}, "required": ["ticker"], "additionalProperties": false}},
      "progress": "Running {n_simulations:,} simulations for {ticker}",
      "responses": {"*": {"title": "{ticker} Monte Carlo valuation", "source": "Monte Carlo engine, seed 42 (recorded fixture)", "as_of": "2026-11-24",
                          "values": {"n_simulations": 10000, "median_value_per_share": 204.36, "p5_value_per_share": 131.08, "p95_value_per_share": 318.72, "prob_below_price": 0.4127, "current_price": 208.11},
                          "assumptions": {"revenue_growth_mean": 0.105, "revenue_growth_sd": 0.03, "operating_margin_mean": 0.115, "wacc_mean": 0.088, "terminal_growth_range": "0.02-0.03", "seed": 42}}}
    },
    "valuation_scenarios": {
      "spec": {"name": "valuation_scenarios",
               "description": "Scenario and stress analysis (bull / base / bear or named shocks): revenue, gross margin, capex and value per share under explicit assumption sets.",
               "input_schema": {"type": "object", "properties": {"ticker": {"type": "string"}, "scenario_set": {"type": "string", "enum": ["bull_base_bear", "geopolitical", "macro"], "default": "bull_base_bear"}}, "required": ["ticker", "scenario_set"], "additionalProperties": false}},
      "responses": {"*": {"title": "{ticker} scenarios", "source": "Scenario engine (recorded fixture)", "as_of": "2026-11-24",
