# Copy to backend/.env (always loaded from this path)
# cp .env.example .env

DEBUG=true
DATABASE_URL=postgresql://...

# Brevo — https://www.brevo.com — create API key + verify sender email in dashboard
BREVO_API_KEY=
BREVO_FROM_EMAIL=QuantTrade AI <your-verified-sender@example.com>

# Local only: if Brevo fails, OTP is printed in uvicorn logs
EMAIL_DEV_LOG_OTP=true

# Stripe — set STRIPE_SECRET_KEY from Dashboard (test vs live must match price IDs)
# Webhook signing secret: Dashboard → Developers → Webhooks → your endpoint → Signing secret
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_THIN_WEBHOOK_SECRET=   # only if Connect thin webhook is enabled
# STRIPE_CONNECT_SUBSCRIPTION_PRICE_ID=price_1TJXgzLE7UInSceyGLZqhuya
# STRIPE_PRICE_PLUS_MONTHLY=price_1TJXgzLE7UInSceyGLZqhuya
# STRIPE_PRICE_PLUS_YEARLY=price_1TKn3VLE7UInSceyL1hFSLTR
# STRIPE_PUBLISHABLE_KEY=pk_live_... or pk_test_...
# APP_URL=http://localhost:3000

# ElevenLabs Voice API Keys
ELEVENLABS_API_KEY=
