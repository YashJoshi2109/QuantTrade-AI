# Copy to backend/.env (always loaded from this path)
# cp .env.example .env

DEBUG=true
DATABASE_URL=postgresql://...

# Brevo — https://www.brevo.com — create API key + verify sender email in dashboard
BREVO_API_KEY=
BREVO_FROM_EMAIL=QuantTrade AI <your-verified-sender@example.com>

# Resend (optional) — https://resend.com — used if Brevo fails; if both keys are set, delete-account OTP is sent via both
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=QuantTrade AI <notify@your-verified-domain.com>

# Local only: if Brevo fails, OTP is printed in uvicorn logs
EMAIL_DEV_LOG_OTP=true

# Stripe — set STRIPE_SECRET_KEY from Dashboard (test vs live must match price IDs)
# Webhook signing secret: Dashboard → Developers → Webhooks → your endpoint → Signing secret
# STRIPE_WEBHOOK_SECRET=
# STRIPE_CONNECT_THIN_WEBHOOK_SECRET=   # only if Connect thin webhook is enabled
# STRIPE_CONNECT_SUBSCRIPTION_PRICE_ID=price_1TJXgzLE7UInSceyGLZqhuya
# STRIPE_PRICE_PLUS_MONTHLY=price_1TJXgzLE7UInSceyGLZqhuya
# STRIPE_PRICE_PLUS_YEARLY=price_1TKn3VLE7UInSceyL1hFSLTR
# STRIPE_PUBLISHABLE_KEY=pk_live_... or pk_test_...
# Welcome email promo (must match Stripe promotion customer code)
# STRIPE_WELCOME_PROMO_CUSTOMER_CODE=QUANTTRADE
# STRIPE_WELCOME_PROMO_AMOUNT_LABEL=$15
# APP_URL=http://localhost:3000
# If APP_URL is localhost but you use live Stripe, set HTTPS return for Customer Portal:
# BILLING_PORTAL_RETURN_URL=https://www.yourdomain.com/settings
# Customer portal (Manage billing): must be activated in Stripe Dashboard → Settings → Billing → Customer portal
# If Session.create fails, run: python3 scripts/verify_stripe_billing_portal.py
# STRIPE_BILLING_PORTAL_CONFIGURATION_ID=bpc_1TK4TgLE7UInSceyq0wyy4ES
# DB migration (once): python scripts/add_welcome_promo_email_column.py
# preferences_json: python3 scripts/add_user_preferences_column.py

# Cloudflare Turnstile CAPTCHA — https://dash.cloudflare.com → Turnstile → Add Site
# TURNSTILE_SECRET_KEY=0x...
# Frontend also needs: NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# ElevenLabs Voice API Keys
ELEVENLABS_API_KEY=

# AWS Bedrock
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_key_here
AWS_SECRET_ACCESS_KEY=your_secret_here

# Qdrant Cloud
QDRANT_URL=https://your-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# EDGAR
EDGAR_USER_AGENT=QuantTrade/1.0 yashjosh7486@gmail.com

# Cohere
COHERE_API_KEY=your_cohere_api_key
