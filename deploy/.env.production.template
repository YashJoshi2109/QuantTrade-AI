# Environment Variables Template for EC2 Production
#
# SECURITY: Never commit a filled copy of this file or push real secrets to Git.
# Copy to /opt/quanttrade/.env on the server (same directory as docker-compose.prod.yml).
# Docker loads it via env_file — it is NOT baked into images.
#
# GitHub Actions "Deploy to Production" rebuilds .env from Secrets and also writes
# WebAuthn lines; use this template for manual installs or to see required keys.

# =============================================================================
# DATABASE - Neon PostgreSQL (Required)
# =============================================================================
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST.neon.tech/neondb?sslmode=require

# =============================================================================
# SECURITY - Generate new secrets for production!
# =============================================================================
# Generate with: openssl rand -hex 32
SECRET_KEY=your-production-jwt-secret-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# =============================================================================
# API KEYS - Stock Market Data
# =============================================================================
# Financial Modeling Prep — real-time quotes, global screener (250 calls/day free)
FMP_API_KEY=your_fmp_api_key

# Twelve Data — real-time quotes, 800+ global exchanges (800 credits/day free)
TWELVEDATA_API_KEY=your_twelve_data_api_key
TWELVE_DATA_API_KEY=your_twelve_data_api_key   # frontend alias

# EOD Historical Data — exchange info, EOD quotes (100 req/day free)
EODHD_API_KEY=your_eodhd_api_key

# ApiLayer Currency Data API — exchange rates (100 req/day free)
APILAYER_CURRENCY_KEY=your_apilayer_key

# Marketstack — global real-time stock data
MARKETSTACK_API_KEY=your_marketstack_key

# OpenFIGI — real-time stock identifiers and info
OPENFIGI_API_KEY=your_openfigi_key

# Finnhub — real-time quotes, insider transactions, SEC filings, IPO calendar, basic financials (free tier: 60 calls/min)
FINNHUB_API_KEY=your_finnhub_api_key

# Alpha Vantage — fundamentals (free tier: 5 calls/min)
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key

# SEC API — SEC filings
SEC_API_KEY=your_sec_api_key

# NewsAPI — real-time news (100 requests/day free)
NEWSAPI_KEY=your_newsapi_key

# Anthropic Claude — AI chat
ANTHROPIC_API_KEY=your_anthropic_api_key

# OpenAI — GPT-4 (optional)
OPENAI_API_KEY=your_openai_api_key

# =============================================================================
# GLOBAL MONITOR API KEYS
# =============================================================================
# The Guardian Open Platform (free "test" key works, or register at https://open-platform.theguardian.com/)
GUARDIAN_API_KEY=test

# ACLED - Armed Conflict Location & Event Data (https://acleddata.com/)
ACLED_API_KEY=
ACLED_EMAIL=
ACLED_PASSWORD=

# FRED - Federal Reserve Economic Data (https://fred.stlouisfed.org/docs/api/api_key.html)
FRED_API_KEY=

# EIA - US Energy Information Administration (https://www.eia.gov/opendata/)
EIA_API_KEY=

# Cloudflare Radar (https://dash.cloudflare.com/ - for internet outage detection)
CLOUDFLARE_RADAR_TOKEN=

# Groq LLM (https://console.groq.com/ - for threat classification)
GROQ_API_KEY=

# OpenRouter AI fallback (https://openrouter.ai/)
OPENROUTER_API_KEY=

# NASA APIs (https://api.nasa.gov/)
NASA_API_KEY=
NASA_FIRMS_API_KEY=

# USGS Earthquake data (public API, optional key)
USGS_API_KEY=

# =============================================================================
# EMAIL / AUTH
# =============================================================================
# Email — Brevo only. Sender must be verified in Brevo (Senders & IP / SMTP).
# GitHub deploy: secrets BREVO_API_KEY, BREVO_FROM_EMAIL (optional; else use default).
BREVO_API_KEY=
BREVO_FROM_EMAIL=QuantTrade AI <noreply@quanttrade.us>

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Neon Auth (Optional)
NEON_AUTH_URL=
NEON_AUTH_JWKS_URL=
NEON_AUTH_AUDIENCE=

# =============================================================================
# STRIPE BILLING (Optional)
# =============================================================================
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CONNECT_THIN_WEBHOOK_SECRET=
STRIPE_CONNECT_SUBSCRIPTION_PRICE_ID=
STRIPE_PRICE_PLUS_MONTHLY=
STRIPE_PRICE_PLUS_YEARLY=

# =============================================================================
# ELEVENLABS (Optional - game voice / sound)
# =============================================================================
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
ELEVENLABS_VOICE_NARRATOR=
ELEVENLABS_VOICE_KNIGHT=
ELEVENLABS_VOICE_SCHOLAR=
ELEVENLABS_VOICE_MERCHANT=
ELEVENLABS_VOICE_NOBLE=
ELEVENLABS_VOICE_SAGE=

# =============================================================================
# FRONTEND PUBLIC KEYS
# =============================================================================
NEXT_PUBLIC_OPENROUTER_API_KEY=

# =============================================================================
# REDIS (Optional - for caching)
# =============================================================================
REDIS_URL=redis://localhost:6379/0

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Public site URL (billing, emails)
APP_URL=https://www.quanttrade.us

# CORS - Update with your actual domain
ALLOWED_ORIGINS=https://www.quanttrade.us,https://quanttrade.us

# =============================================================================
# WEBAUTHN / PASSKEYS (must match the hostname users see in the browser)
# =============================================================================
WEBAUTHN_RP_ID=quanttrade.us
WEBAUTHN_ORIGIN=https://www.quanttrade.us
WEBAUTHN_ORIGINS=https://www.quanttrade.us,https://quanttrade.us
# RATE LIMITING
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
